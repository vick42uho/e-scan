# ==========================================
# Yanhee e-Scan System (DMS) .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env*.local
.env.*
!.env.example
!.env*.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
env/
venv/
ENV/
*.pyproj
*.pydevproject

# Node.js & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel
*.tsbuildinfo
frontend/*.tsbuildinfo

# Uploaded Storage Files (keep folder structure via .gitkeep)
backend/storage/documents/*
!backend/storage/documents/.gitkeep
backend/storage/thumbnails/*
!backend/storage/thumbnails/.gitkeep

# Reference & Samples (large binaries / confidential mock assets)
ตัวอย่าง/
*.rar
~$*

# OS & Editor Files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
